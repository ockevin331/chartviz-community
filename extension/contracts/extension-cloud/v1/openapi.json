            "type": "array"
          },
          "tradePlan": {
            "$ref": "#/components/schemas/ExtensionTradePlan"
          },
          "tradeSignals": {
            "items": {
              "$ref": "#/components/schemas/ExtensionTradeSignal"
            },
            "maxItems": 6,
            "title": "Tradesignals",
            "type": "array"
          }
        },
        "required": [
          "context",
          "conclusion",
          "marketExplanation",
          "tradePlan",
          "timeframeViews",
          "riskNotice"
        ],
        "title": "ExtensionReport",
        "type": "object"
      },
      "ExtensionReportContext": {
        "additionalProperties": false,
        "properties": {
          "captures": {
            "items": {
              "$ref": "#/components/schemas/ExtensionCaptureMetadata"
            },
            "maxItems": 3,
            "minItems": 1,
            "title": "Captures",
            "type": "array"
          },
          "instrument": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Instrument"
          },
          "outputLanguage": {
            "enum": [
              "en",
              "zh-CN"
            ],
            "title": "Outputlanguage",
            "type": "string"
          },
          "venue": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Venue"
          }
        },
        "required": [
          "outputLanguage",
          "captures"
        ],
        "title": "ExtensionReportContext",
        "type": "object"
      },
      "ExtensionScenario": {
        "additionalProperties": false,
        "properties": {
          "condition": {
            "minLength": 1,
            "title": "Condition",
            "type": "string"
          },
          "entry": {
            "minLength": 1,
            "title": "Entry",
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          },
          "stop": {
            "minLength": 1,
            "title": "Stop",
            "type": "string"
          },
          "targets": {
            "items": {
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 1,
            "title": "Targets",
            "type": "array"
          }
        },
        "required": [
          "condition",
          "entry",
          "stop",
          "targets",
          "reason"
        ],
        "title": "ExtensionScenario",
        "type": "object"
      },
      "ExtensionSelectedModel": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "name": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "quotaCost": {
            "minimum": 1,
            "title": "Quotacost",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "quotaCost"
        ],
        "title": "ExtensionSelectedModel",
        "type": "object"
      },
      "ExtensionSignalPoint": {
        "additionalProperties": false,
        "properties": {
          "priceLabel": {
            "minLength": 1,
            "title": "Pricelabel",
            "type": "string"
          },
          "xRatio": {
            "anyOf": [
              {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Xratio"
          },
          "yRatio": {
            "maximum": 1,
            "minimum": 0,
            "title": "Yratio",
            "type": "number"
          }
        },
        "required": [
          "priceLabel",
          "yRatio"
        ],
        "title": "ExtensionSignalPoint",
        "type": "object"
      },
      "ExtensionTimeframeView": {
        "additionalProperties": false,
        "properties": {
          "captureId": {
            "pattern": "^C0[1-3]$",
            "title": "Captureid",
            "type": "string"
          },
          "conclusion": {
            "minLength": 1,
            "title": "Conclusion",
            "type": "string"
          },
          "confidence": {
            "maximum": 1,
            "minimum": 0,
            "title": "Confidence",
            "type": "number"
          },
          "evidence": {
            "items": {
              "type": "string"
            },
            "maxItems": 6,
            "minItems": 1,
            "title": "Evidence",
            "type": "array"
          },
          "role": {
            "anyOf": [
              {
                "enum": [
                  "context",
                  "setup",
                  "trigger",
                  "setup_and_trigger"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Role"
          },
          "structure": {
            "enum": [
              "hh-hl",
              "lh-ll",
              "range",
              "transition",
              "unclear"
            ],
            "title": "Structure",
            "type": "string"
          },
          "timeframe": {
            "maxLength": 8,
            "minLength": 1,
            "title": "Timeframe",
            "type": "string"
          },
          "trend": {
            "enum": [
              "bullish",
              "bearish",
              "sideways",
              "unclear"
            ],
            "title": "Trend",
            "type": "string"
          }
        },
        "required": [
          "captureId",
          "timeframe",
          "trend",
          "structure",
          "conclusion",
          "evidence",
          "confidence"
        ],
