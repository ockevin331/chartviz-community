      "ExtensionTradeSignal": {
        "additionalProperties": false,
        "properties": {
          "captureId": {
            "pattern": "^C0[1-3]$",
            "title": "Captureid",
            "type": "string"
          },
          "confidence": {
            "maximum": 1,
            "minimum": 0,
