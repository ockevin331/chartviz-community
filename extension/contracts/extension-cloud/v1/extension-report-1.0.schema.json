  "additionalProperties": false,
  "properties": {
    "conclusion": {
      "$ref": "#/$defs/ExtensionConclusion"
    },
    "context": {
      "$ref": "#/$defs/ExtensionReportContext"
    },
    "drawings": {
      "items": {
        "$ref": "#/$defs/ExtensionDrawing"
      },
      "maxItems": 32,
      "title": "Drawings",
      "type": "array"
    },
    "levels": {
      "items": {
        "$ref": "#/$defs/ExtensionLevel"
      },
      "maxItems": 8,
      "title": "Levels",
      "type": "array"
    },
    "marketExplanation": {
      "$ref": "#/$defs/ExtensionMarketExplanation"
    },
    "patterns": {
      "items": {
        "$ref": "#/$defs/ExtensionPattern"
      },
      "maxItems": 3,
      "title": "Patterns",
      "type": "array"
    },
    "riskNotice": {
      "minLength": 1,
      "title": "Risknotice",
      "type": "string"
    },
    "schemaVersion": {
      "const": "extension-report-1.0",
      "default": "extension-report-1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "timeframeViews": {
      "items": {
        "$ref": "#/$defs/ExtensionTimeframeView"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Timeframeviews",
      "type": "array"
    },
    "tradePlan": {
      "$ref": "#/$defs/ExtensionTradePlan"
    },
    "tradeSignals": {
      "items": {
        "$ref": "#/$defs/ExtensionTradeSignal"
      },
      "maxItems": 6,
      "title": "Tradesignals",
      "type": "array"
    }
  },
  "required": [
    "context",
    "conclusion",
    "marketExplanation",
    "tradePlan",
    "timeframeViews",
    "riskNotice"
  ],
  "title": "ExtensionReport",
  "type": "object"
}
