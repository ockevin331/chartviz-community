          "title": "Stop",
          "type": "string"
        },
        "targets": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Targets",
          "type": "array"
        }
      },
      "required": [
        "condition",
        "entry",
        "stop",
        "targets",
        "reason"
