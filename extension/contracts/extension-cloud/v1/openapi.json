          "content": {
            "multipart/form-data": {
              "encoding": {
                "metadata": {
                  "contentType": "application/json"
                }
              },
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "images": {
                    "items": {
                      "format": "binary",
                      "type": "string"
                    },
                    "maxItems": 3,
                    "minItems": 1,
                    "type": "array"
                  },
                  "metadata": {
                    "$ref": "#/components/schemas/ExtensionAnalysisCreateMetadata"
                  }
                },
                "required": [
                  "metadata",
                  "images"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionAnalysisTask"
                }
              }
            },
            "description": "Task accepted"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionApiError"
                }
              }
            },
            "description": "Request failed"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionApiError"
                }
              }
            },
            "description": "Request failed"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionApiError"
                }
              }
            },
            "description": "Request failed"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionApiError"
                }
              }
            },
            "description": "Request failed"
          }
        },
        "security": [
          {
            "CloudToken": []
          }
        ]
      }
    },
