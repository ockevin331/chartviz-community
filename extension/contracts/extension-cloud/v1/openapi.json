          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionApiError"
                }
              }
            },
            "description": "Request failed"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionApiError"
                }
              }
            },
            "description": "Request failed"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionApiError"
                }
              }
            },
            "description": "Request failed"
          }
        },
        "security": [
          {
            "CloudToken": []
          }
        ]
      }
