        "signalTime": {
          "minLength": 1,
          "title": "Signaltime",
          "type": "string"
        },
        "signalType": {
          "minLength": 1,
          "title": "Signaltype",
          "type": "string"
        },
        "stopLoss": {
          "$ref": "#/$defs/ExtensionSignalPoint"
        },
        "takeProfits": {
          "items": {
            "$ref": "#/$defs/ExtensionSignalPoint"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Takeprofits",
          "type": "array"
        },
        "thesisAtSignal": {
          "minLength": 1,
          "title": "Thesisatsignal",
          "type": "string"
        }
      },
      "required": [
        "id",
        "captureId",
        "direction",
        "signalType",
        "signalTime",
        "thesisAtSignal",
        "evidenceAtSignal",
        "entry",
        "stopLoss",
        "takeProfits",
        "invalidation",
        "confidence"
      ],
