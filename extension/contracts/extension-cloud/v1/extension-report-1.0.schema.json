      "type": "object"
    },
    "ExtensionTimeframeView": {
      "additionalProperties": false,
      "properties": {
        "captureId": {
          "pattern": "^C0[1-3]$",
          "title": "Captureid",
          "type": "string"
        },
        "conclusion": {
          "minLength": 1,
          "title": "Conclusion",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "context",
                "setup",
                "trigger"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "structure": {
          "enum": [
            "hh-hl",
            "lh-ll",
            "range",
            "transition",
            "unclear"
          ],
          "title": "Structure",
          "type": "string"
        },
        "timeframe": {
          "maxLength": 8,
          "minLength": 1,
          "title": "Timeframe",
          "type": "string"
        },
        "trend": {
          "enum": [
            "bullish",
            "bearish",
            "sideways",
            "unclear"
          ],
          "title": "Trend",
          "type": "string"
