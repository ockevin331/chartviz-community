            "description": "Successful response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionApiError"
                }
              }
            },
            "description": "Request failed"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionApiError"
                }
              }
            },
            "description": "Request failed"
          }
        },
        "security": [
          {
            "CloudToken": []
