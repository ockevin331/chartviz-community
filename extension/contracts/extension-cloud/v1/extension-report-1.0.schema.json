        "short": {
          "$ref": "#/$defs/ExtensionScenario"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "wait": {
          "$ref": "#/$defs/ExtensionWaitScenario"
