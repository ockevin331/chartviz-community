    "/api/v1/extension/account": {
      "get": {
        "operationId": "getExtensionAccount",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionAccount"
                }
              }
            },
            "description": "Successful response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionApiError"
                }
              }
            },
            "description": "Request failed"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionApiError"
                }
              }
            },
            "description": "Request failed"
          }
        },
        "security": [
          {
            "CloudToken": []
          }
        ]
      }
    },
