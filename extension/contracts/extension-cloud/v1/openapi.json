            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionApiError"
                }
              }
            },
            "description": "Request failed"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionApiError"
                }
              }
            },
            "description": "Request failed"
          }
        },
        "security": [
          {
            "CloudToken": []
          }
        ]
      }
    },
