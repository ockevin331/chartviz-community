        "timeframe",
        "trend",
        "structure",
        "conclusion",
        "evidence",
        "confidence"
      ],
      "title": "ExtensionTimeframeView",
      "type": "object"
    },
    "ExtensionTradePlan": {
      "additionalProperties": false,
      "properties": {
        "long": {
          "$ref": "#/$defs/ExtensionScenario"
