    "ExtensionTradeSignal": {
      "additionalProperties": false,
      "properties": {
        "captureId": {
          "pattern": "^C0[1-3]$",
          "title": "Captureid",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "direction": {
          "enum": [
            "long",
            "short"
          ],
          "title": "Direction",
          "type": "string"
        },
        "entry": {
          "$ref": "#/$defs/ExtensionSignalPoint"
