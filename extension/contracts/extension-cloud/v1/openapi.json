    "/api/v1/extension/analysis-tasks/{task_id}/captures/{capture_id}": {
      "get": {
        "operationId": "getExtensionAnalysisCapture",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "capture_id",
            "required": true,
            "schema": {
              "enum": [
                "C01",
                "C02",
                "C03"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "image/png": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "Capture image"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtensionApiError"
