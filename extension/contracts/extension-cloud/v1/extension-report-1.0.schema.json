        "evidenceAtSignal": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Evidenceatsignal",
          "type": "array"
        },
        "id": {
          "pattern": "^S\\d{2}$",
          "title": "Id",
          "type": "string"
        },
        "invalidation": {
          "minLength": 1,
          "title": "Invalidation",
          "type": "string"
        },
        "riskReward": {
