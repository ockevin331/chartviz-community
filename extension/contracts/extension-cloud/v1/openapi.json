          "evidenceAtSignal": {
            "items": {
              "type": "string"
            },
            "maxItems": 6,
            "minItems": 1,
            "title": "Evidenceatsignal",
            "type": "array"
          },
          "id": {
            "pattern": "^S\\d{2}$",
            "title": "Id",
            "type": "string"
          },
          "invalidation": {
            "minLength": 1,
            "title": "Invalidation",
            "type": "string"
          },
          "riskReward": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Riskreward"
          },
          "signalTime": {
            "minLength": 1,
            "title": "Signaltime",
            "type": "string"
          },
          "signalType": {
            "minLength": 1,
            "title": "Signaltype",
            "type": "string"
          },
          "stopLoss": {
            "$ref": "#/components/schemas/ExtensionSignalPoint"
          },
          "takeProfits": {
            "items": {
              "$ref": "#/components/schemas/ExtensionSignalPoint"
            },
            "maxItems": 3,
            "minItems": 1,
            "title": "Takeprofits",
            "type": "array"
          },
          "thesisAtSignal": {
            "minLength": 1,
            "title": "Thesisatsignal",
            "type": "string"
          }
        },
        "required": [
          "id",
          "captureId",
          "direction",
          "signalType",
          "signalTime",
          "thesisAtSignal",
          "evidenceAtSignal",
          "entry",
          "stopLoss",
          "takeProfits",
          "invalidation",
          "confidence"
        ],
        "title": "ExtensionTradeSignal",
        "type": "object"
      },
      "ExtensionVolumeExplanation": {
        "additionalProperties": false,
        "properties": {
          "implication": {
            "minLength": 1,
            "title": "Implication",
            "type": "string"
          },
          "summary": {
            "minLength": 1,
            "title": "Summary",
            "type": "string"
          },
          "timeAnchor": {
            "minLength": 1,
            "title": "Timeanchor",
            "type": "string"
          }
        },
        "required": [
